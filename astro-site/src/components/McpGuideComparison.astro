---
import { coverageColumns, coverageRows, relationships, licensingRows, telemetryRows } from '../lib/mcpGovernance';
import McpSourceRefs from './McpSourceRefs.astro';
interface Props { kind: 'coverage' | 'licensing' | 'telemetry' }
const {kind} = Astro.props;
const marks = {primary: {symbol:'●',label:'Primary fit'},conditional:{symbol:'◐',label:'Conditional'},none:{symbol:'○',label:'Outside role'}};
const heading = kind === 'coverage' ? 'Match the control to the path' : kind === 'licensing' ? 'E7 rights and the bill behind the path' : 'Collect evidence from each plane';
---
<figure class="mcp-comparison" data-mcp-comparison={kind} aria-labelledby={`${kind}-heading`}>
 <header><span class="kicker">{kind === 'coverage' ? 'Capability / relationship map' : kind === 'licensing' ? 'Entitlement / consumption map' : 'Operational evidence map'}</span><h3 id={`${kind}-heading`}>{heading}</h3></header>
 {kind === 'coverage' ? <>
  <p class="intro">Roles overlap. Coverage depends on the configured product, tier, transport and request path. These symbols describe technical fit, not license inclusion or guaranteed coverage.</p>
  <ul class="legend" aria-label="Capability symbols">{Object.values(marks).map(m => <li><span aria-hidden="true">{m.symbol}</span> {m.label}</li>)}</ul>
  <p class="scroll-hint" id="coverage-scroll-hint">Scroll horizontally to compare columns. Keyboard: focus the table region and use the arrow keys.</p>
  <div class="table-region" tabindex="0" role="region" aria-label="MCP capability comparison, horizontally scrollable" aria-describedby="coverage-scroll-hint">
   <table><caption>Primary role, conditional contribution, or outside this product’s role</caption><thead><tr><th scope="col">Control</th>{coverageColumns.map(c => <th scope="col">{c}</th>)}</tr></thead>
    <tbody>{coverageRows.map(r => <tr><th scope="row"><strong>{r.product}</strong><span class="role-note">{r.note}</span><McpSourceRefs ids={r.sources} /></th>{r.values.map(v => <td data-coverage={v}><span class={`coverage-mark ${v}`} aria-hidden="true">{marks[v].symbol}</span><span class="mark-label">{marks[v].label}</span></td>)}</tr>)}</tbody>
   </table>
  </div>
  <section class="relationships" aria-labelledby="relationships-heading"><h4 id="relationships-heading">Overlap can be useful coexistence</h4><p class="pair-legend"><strong>≈</strong> overlapping responsibility <span aria-hidden="true">/</span> <strong>+</strong> complementary roles. A pair can have both.</p>
   <dl>{relationships.map(r => <div><dt><span class="pair-symbol" aria-hidden="true">{r.symbol}</span>{r.pair}<small>{r.label}</small></dt><dd>{r.text} <McpSourceRefs ids={r.sources} /></dd></div>)}</dl>
  </section>
 </> : kind === 'licensing' ? <>
  <p class="intro">Public guidance checked October 30, 2026. Entitlement, rollout, configuration and consumption are separate checks. Your agreement and Product Terms govern.</p>
  <div class="comparison-list">{licensingRows.map(r => <section class="comparison-row"><h4>{r.product}</h4><p class="status">{r.status}</p><p>{r.text} <McpSourceRefs ids={r.sources} /></p></section>)}</div>
 </> : <>
  <p class="intro">My collection checklist. None of these consoles supplies every other plane’s evidence automatically.</p>
  <div class="comparison-list telemetry">{telemetryRows.map(r => <section class="comparison-row"><h4><small>{r.plane}</small>{r.service}</h4><p><strong>Evidence:</strong> {r.evidence}</p><p><strong>Setup / gap:</strong> {r.gap} <McpSourceRefs ids={r.sources} /></p></section>)}</div>
 </>}
 <figcaption>{kind === 'coverage' ? 'Read the row qualification with the symbol. “Outside role” means this is not the control I would select for that job, not a claim that the product has no adjacent features.' : kind === 'licensing' ? 'Included user rights do not create an enforced request path or unlimited model/log capacity. Preview features and unpublished pricing need separate validation.' : 'Record the policy decision and the target outcome separately. A blocked response after execution cannot undo an action already completed.'}</figcaption>
</figure>
<style>
 .mcp-comparison{position:relative;isolation:isolate;margin:0;background:#fbfaf6;border:1px solid #c9c4b8;border-radius:12px;overflow:clip;color:#132235;font-family:var(--font-sans,'Manrope',sans-serif)}.mcp-comparison *{box-sizing:border-box}.mcp-comparison :is(p,h3,h4,ul,li,dl,dd){margin:0;color:inherit}.mcp-comparison p,.mcp-comparison dd{font-size:18px;line-height:1.55}.mcp-comparison header{padding:clamp(22px,3vw,36px);background:#132235;color:#fbfaf6}.kicker{color:#a5b8ee;font-size:12px;text-transform:uppercase;letter-spacing:.13em;font-weight:800}.mcp-comparison h3{font-size:clamp(25px,3vw,35px);line-height:1.2;color:inherit;margin-top:8px}.intro{padding:24px clamp(18px,2.5vw,32px) 16px}.legend{display:flex;flex-wrap:wrap;gap:12px 25px;list-style:none;padding:0 clamp(18px,2.5vw,32px)!important}.legend li{font-size:18px;margin:0!important}.legend li>span{font-size:25px;vertical-align:-1px;margin-right:5px}.scroll-hint{padding:14px clamp(18px,2.5vw,32px);font-size:16px!important}.table-region{overflow-x:auto;overscroll-behavior-x:contain;scrollbar-color:#50687c #e9e2d4}.table-region:focus-visible{outline:3px solid #008fd3;outline-offset:-3px}.mcp-comparison table{border-collapse:collapse;min-width:1050px;width:100%;margin:0;font-size:18px;line-height:1.4;table-layout:fixed}.mcp-comparison caption{text-align:left;padding:14px 22px;background:#e9e2d4;font-size:16px}.mcp-comparison th,.mcp-comparison td{padding:20px 12px;border:1px solid #d5d0c5;vertical-align:top;color:#132235}.mcp-comparison thead th{background:#e8effa;font-size:17px;text-align:center;overflow-wrap:normal}.mcp-comparison thead th:first-child{width:300px;text-align:left}.mcp-comparison tbody th{font-weight:500;text-align:left;background:#f4f1ea}.mcp-comparison tbody th strong{font-size:20px;display:block}.role-note{display:block;font-size:17px;line-height:1.5;margin:10px 0}.mcp-comparison td{text-align:center}.coverage-mark{display:block;font-size:32px;line-height:1.3}.coverage-mark.primary{color:#173d61}.coverage-mark.conditional{color:#70550b}.coverage-mark.none{color:#526372}.mark-label{display:block;font-size:16px;line-height:1.35;margin-top:7px}.relationships{padding:28px clamp(18px,2.5vw,32px);border-top:1px solid #c9c4b8}.relationships>h4{font-size:25px;line-height:1.25;margin-bottom:12px}.pair-legend{font-size:17px!important;margin-bottom:22px!important}.relationships dl>div{display:grid;grid-template-columns:270px minmax(0,1fr);gap:22px;padding:22px 0;border-top:1px solid #d5d0c5}.relationships dt{font-size:20px;font-weight:800}.pair-symbol{display:block;color:#173d61;font-size:28px}.relationships small{display:block;font-size:16px;font-weight:550;margin-top:6px;line-height:1.45}.comparison-row{display:grid;grid-template-columns:minmax(155px,1fr) minmax(155px,.9fr) minmax(0,2.2fr);gap:24px;padding:25px clamp(18px,2.5vw,32px);border-top:1px solid #d5d0c5}.comparison-row h4{font-size:20px;line-height:1.4}.comparison-row .status{font-size:17px;line-height:1.45;font-weight:800;color:#173d61}.comparison-row h4 small{display:block;font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}.telemetry .comparison-row{grid-template-columns:minmax(180px,1fr) minmax(0,1.3fr) minmax(0,1.7fr)}figcaption{padding:22px clamp(18px,2.5vw,32px);background:#f4f1ea;border-top:1px solid #c9c4b8;font-size:16px;line-height:1.5}
 @media(max-width:720px){.relationships dl>div,.comparison-row,.telemetry .comparison-row{grid-template-columns:1fr;gap:12px}.pair-symbol{display:inline;margin-right:10px}.relationships dt{font-size:21px}.comparison-row .status{border-left:3px solid #008fd3;padding-left:12px}.mcp-comparison{overflow-wrap:break-word}}
</style>
