---
import type { Post } from '../lib/content';

interface Props {
  post: Post;
  showPresentAction?: boolean;
}

const { post, showPresentAction = false } = Astro.props;
---

<header class="post-hero">
  <span class="eyebrow">{post.category}</span>
  <h1 class="post-heading">{post.title}</h1>
  <div class="post-meta-row">
    <span>{post.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
    <span>{post.readingTime} min read</span>
  </div>
  {post.tags.length > 0 && (
    <div class="post-tags">
      {post.tags.map((tag) => <span class="post-tag">{tag}</span>)}
    </div>
  )}
  {showPresentAction && post.presentHref && (
    <div class="post-hero-actions">
      <a class="post-hero-action" href={post.presentHref}>Present</a>
    </div>
  )}
</header>

<style>
  .post-tags {
    margin-top: 1rem;
  }
</style>
