---
import { branchLinks, chapters, imageSlots, linkPaths, slotExists } from '../lib/walkingDeck';

const sections = [
  { id: 'signal-human', label: 'Intro' },
  { id: 'signal-cover', label: 'Signal' },
  { id: 'signal-strengths', label: 'Range' },
  { id: 'signal-impact', label: 'Journey' },
  { id: 'signal-voices', label: 'Voices' },
  { id: 'signal-ask', label: 'Next' },
];
const kicker = (id: string, title: string) => `Section ${String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0')} · ${title}`;
const portrait = imageSlots[0];
const pad = (n: number) => String(n).padStart(2, '0');

interface Props {
  startInPresent?: boolean;
  exitHref?: string;
}

const { startInPresent = false, exitHref } = Astro.props;

const pitchTerminalLines = [
  { prompt: '$', text: 'whoami --short' },
  { out: 'Senior Security Solution Engineer at Microsoft. Career seller before that.' },
  { prompt: '$', text: 'cat reinvention.story | head' },
  { out: 'Sales, service, and entrepreneurship first. Loved the work.' },
  { out: 'Reinvented: MSP by day, cyber bootcamp instructor by night.' },
  { out: 'CPCC A.A.S. opened the Microsoft door in 2021. SANS B.P.S. earned while here.' },
  { out: 'Azure Networking Rapid Response, then Security STU after three years.' },
  { prompt: '$', text: 'echo $THESIS' },
  { out: 'I did not leave sales because I was burnt out. I loved it.' },
  { out: 'I rebuilt on security depth so the next sales seat compounds everything.' },
  { prompt: '$', text: 'grep FY26 results.log' },
  { out: '4 of 4 revenue buckets exceeded. 100% attainment, US HLS.' },
  { prompt: '$', text: 'echo $NEXT' },
  { out: 'GBB Security Solution Sales Advisor. Then sales leadership.' },
  { prompt: '$', text: '_' },
];

const pitchStory = [
  {
    label: 'Where I started',
    title: 'Sales, service, and entrepreneurship.',
    detail: 'A decade of selling, leading, military service, and running my own hometown gym.',
  },
  {
    label: 'The reinvention',
    title: 'MSP by day, cyber instructor by night.',
    detail: 'Sold the gym before the pandemic and rebuilt deliberately around security depth.',
  },
  {
    label: 'Microsoft, fueled by curiosity',
    title: 'A.A.S. at the door. B.P.S. while in the seat.',
    detail: 'CPCC Cloud and Virtualization opened Azure Networking Rapid Response. A SANS B.P.S. in Applied Cybersecurity, earned on nights and weekends, pulled me into the Security STU.',
  },
];

const salesProof = [
  { metric: '8-figure TCV', detail: 'Microsoft 365 E5 step-up' },
  { metric: '7-figure', detail: 'Identity governance motion' },
  { metric: 'Mid-6-figure', detail: 'Defender Experts expansion' },
];

const recognitionBadges = [
  {
    id: 'attainment',
    title: '100% Sales Attainment',
    detail: 'Microsoft - 2026',
    src: '/assets/images/walking-deck/recognition/sales-attainment-2026.png',
    alt: 'Microsoft 100 percent sales attainment badge for 2026',
    width: 1200,
    height: 627,
  },
  {
    id: 'culture',
    title: 'Living Our Culture',
    detail: 'Microsoft - FY26 Q3',
    src: '/assets/images/walking-deck/recognition/living-our-culture-fy26-q3.png',
    alt: 'Microsoft Living Our Culture award badge, FY26 Q3',
    width: 1200,
    height: 627,
  },
  {
    id: 'sales-excellence',
    title: 'Sales Excellence Momentum Program',
    detail: 'Enterprise Sales Ready - FY26 H2',
    src: '/assets/images/walking-deck/recognition/sales-excellence-momentum-fy26-h2.png',
    alt: 'Sales Excellence Momentum Program badge for Enterprise Sales Ready, FY26 H2',
    width: 1024,
    height: 1024,
  },
  {
    id: 'hackathon',
    title: 'Hackathon Challenge Winner',
    detail: 'Microsoft - 2025',
    src: '/assets/images/walking-deck/recognition/hackathon-2025-challenge-winner.png',
    alt: 'Microsoft Hackathon 2025 Challenge Winner badge',
    width: 340,
    height: 340,
  },
];

const voices = [
  {
    "hue": "38",
    "init": "ES",
    "role": "Microsoft leader",
    "quote": "Thor consistently operates at the next level, demonstrating strong judgment and independence in complex, ambiguous environments. He translates emerging requirements into scalable, repeatable mechanisms that drive measurable impact across teams. His cross-functional influence and ability to create clarity where none exists elevate both execution and strategy.",
    "name": "Erfan Setork",
    "title": "Sr Solution Engineer Mgmt"
  },
  {
    "hue": "168",
    "init": "CK",
    "role": "Sales security peer",
    "quote": "It is a privilege to work with Thor Draper as my Sr. Solution Engineer. Thor has excelled in his role as a Senior Solution Engineer specializing in security. Thor consistently demonstrates a deep understanding of complex security challenges and offers innovative solutions that deliver measurable results. His technical expertise is complemented by exceptional communication skills, allowing him to effectively translate technical concepts to stakeholders at all levels.",
    "name": "Chad Krantz",
    "title": "Sr. Security Specialist"
  },
  {
    "hue": "200",
    "init": "KU",
    "role": "Cross-org technical teammate",
    "quote": "Your technical knowledge, easy-going personality and dependability, I know that if I reach out to for help with a customer of mine, you'll make yourself available to engage as needed. And likewise, I know that you have no hesitation in reaching out to me when you're seeking my input or opinion on a customer matter.",
    "name": "Kevin Uy",
    "title": "Principal Cloud Solution Architect"
  }
];
---

<section
  class="wd"
  data-walking-signal
  data-presentation-deck
  data-section-selector="[data-signal-section]"
  data-present={startInPresent ? 'true' : undefined}
  data-exit-href={exitHref}
>
  <nav class="wd-rail" aria-label="Walking deck sections">
    {sections.map((s) => <a href={`#${s.id}`} data-presentation-link>{s.label}</a>)}
    <button type="button" class="wd-present" data-present-toggle aria-label="Enter presentation mode">&#9654; Present</button>
  </nav>

  <div class="wd-hud" data-present-hud aria-hidden={startInPresent ? 'false' : 'true'}>
    <span class="wd-hud-count" data-present-counter>Section 01 / {pad(sections.length)}</span>
    <span class="wd-hud-title" data-present-title>{sections[0].label}</span>
    <button type="button" data-present-prev aria-label="Previous section">&lsaquo;</button>
    <button type="button" data-present-next aria-label="Next section">&rsaquo;</button>
    <button type="button" data-present-exit aria-label="Exit presentation">Exit</button>
  </div>

  <section class:list={['wd-slide', 'is-dark', 'wd-human', startInPresent && 'is-current']} id="signal-human" data-signal-section data-presentation-title="Intro" aria-labelledby="signal-human-title">
    <header class="wd-head">
      <span class="wd-kicker">{kicker('signal-human', "Hi, I'm Thor")}</span>
      <h2 id="signal-human-title">Start with the person.</h2>
      <p>Thor Draper Jr. Charlotte native, back in uptown two blocks from the Belk Theater. Sports junkie: Panthers, Hornets, Yankees. Married my wife in Banff on 7/11 (her birthday plus mine). Our adopted mutt Lloyd handles the household charisma.</p>
    </header>
    <div class="wd-collage">
      {imageSlots.slice(1).filter(slotExists).map((slot, i) => (
        <figure style={`--tilt: ${slot.tilt ?? 0}deg; --i: ${i}`}>
          <img src={slot.src} alt={slot.alt} loading="lazy" decoding="async" />
          {slot.caption && <figcaption>{slot.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>

  <section class="wd-slide is-dark wd-cover" id="signal-cover" data-signal-section data-presentation-title="Signal" aria-labelledby="signal-cover-title">
    <div class="wd-cover-copy">
      <span class="wd-kicker">{kicker('signal-cover', 'The Career Signal')}</span>
      <h2 id="signal-cover-title">A seller's instinct, rebuilt on technical depth.</h2>
      <p class="wd-role"><span>Senior Security Solution Engineer, Microsoft</span><span>Charlotte, NC</span></p>

      <div class="wd-pitch" data-pitch-shell data-pitch-mode="executive">
        <div class="wd-toggle" role="group" aria-label="Pitch display mode">
          <button type="button" class="is-active" data-pitch-mode-button="executive" aria-pressed="true">Executive</button>
          <button type="button" data-pitch-mode-button="backend" aria-pressed="false">Backend</button>
        </div>
        <div class="wd-card" data-pitch-executive>
          <h3>I loved sales enough to rebuild the technical depth around it.</h3>
          <p>A decade of selling and leading, then six years of hands-on cloud and security work. Now I want to carry the security number.</p>
          <ol class="wd-story">
            {pitchStory.map((item, i) => (
              <li><span>{pad(i + 1)} &middot; {item.label}</span><strong>{item.title}</strong><p>{item.detail}</p></li>
            ))}
          </ol>
          <p class="wd-thesis"><span>Thesis</span>Sales judgment, now backed by security depth. <strong>I can connect a customer's security risk to a business case and a deal.</strong></p>
        </div>
        <div class="wd-terminal" data-pitch hidden>
          <header><span>~/career/elevator-pitch.sh</span><button type="button" data-pitch-skip>skip</button></header>
          <pre data-pitch-stream aria-live="polite"><code data-pitch-output></code><span class="wd-cursor" aria-hidden="true">_</span></pre>
          <script type="application/json" data-pitch-script set:html={JSON.stringify({ lines: pitchTerminalLines })}></script>
        </div>
      </div>
    </div>
    {slotExists(portrait) && (
      <figure class="wd-portrait">
        <img src={portrait.src} alt={portrait.alt} loading="eager" />
        <figcaption><strong>Thor Draper Jr</strong><span>Senior Security Solution Engineer &middot; Microsoft</span></figcaption>
      </figure>
    )}
  </section>

  <section class="wd-slide is-dark" id="signal-strengths" data-signal-section data-presentation-title="Range" aria-labelledby="signal-strengths-title">
    <header class="wd-head">
      <span class="wd-kicker">{kicker('signal-strengths', 'What I Bring')}</span>
      <h2 id="signal-strengths-title">I sell security the way a GBB should.</h2>
    </header>
    <ul class="wd-grid wd-strengths">
      <li><strong>I make the market with the account team.</strong><span>Pre-sales across U.S. healthcare payors, providers, and life sciences. I shape security opportunities with the seller and build trust with the people who own the budget and the risk.</span></li>
      <li><strong>I run the v-team from discovery to proof.</strong><span>I lead discovery, architecture reviews, workshops, and demos, then pull in specialists, engineering, and partners to get a customer to a deployment plan.</span></li>
      <li><strong>I build the business case.</strong><span>A 40-plus-person branch with a P&amp;L, a business I owned and sold, and payroll and technology sales before Microsoft. I translate posture gaps into cost, risk, and a decision.</span></li>
    </ul>
    <ul class="wd-grid wd-proof" aria-label="FY26 sales outcomes">
      {salesProof.map((p) => <li><strong>{p.metric}</strong><span>{p.detail}</span></li>)}
    </ul>
    <ul class="wd-recognized" aria-label="Microsoft badges and awards">
      {recognitionBadges.map((b) => (
        <li><img src={b.src} alt={b.alt} width={b.width} height={b.height} loading="lazy" decoding="async" /><strong>{b.title}</strong><span>{b.detail}</span></li>
      ))}
    </ul>
  </section>

  <section class="wd-slide is-dark" id="signal-impact" data-signal-section data-presentation-title="Journey" aria-labelledby="signal-impact-title">
    <header class="wd-head">
      <span class="wd-kicker">{kicker('signal-impact', 'How I Built the Range')}</span>
      <h2 id="signal-impact-title">Each chapter added something I carry into the next seat.</h2>
    </header>
    <div class="wd-journey" data-sphere>
      <div class="wd-map" role="tablist" aria-label="Career chapters">
        <svg viewBox="0 0 1000 420" preserveAspectRatio="none" aria-hidden="true">
          {branchLinks.map((bl) => <path class={`wd-branch is-${bl.kind}`} data-branch-parent={bl.parent} d={bl.d} />)}
          {linkPaths.map((d, i) => <path class="wd-link" data-link={i} d={d} />)}
        </svg>
        {chapters.map((ch, i) => ch.branches.map((b) => (
          <span class={`wd-leaf is-${b.kind}`} data-branch-parent={i} style={`--x:${b.cx / 10}%;--y:${b.cy / 4.2}%`} aria-hidden="true"><i></i>{b.label}</span>
        )))}
        {chapters.map((ch, i) => (
          <button
            type="button"
            role="tab"
            class:list={['wd-node', i === 0 && 'is-active is-lit']}
            style={`--x:${ch.cx / 10}%;--y:${ch.cy / 4.2}%`}
            id={`wd-tab-${ch.id}`}
            aria-controls={`wd-panel-${ch.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-node-button={i}
          >
            <span class="wd-glyph">{ch.glyph}</span>
            <span class="wd-node-label"><strong>{ch.tag}</strong><em>{ch.era}</em></span>
          </button>
        ))}
      </div>
      {chapters.map((ch, i) => (
        <article class="wd-chapter" id={`wd-panel-${ch.id}`} role="tabpanel" aria-labelledby={`wd-tab-${ch.id}`} hidden={i !== 0}>
          {ch.image && <img class="wd-chapter-img" src={ch.image} alt="" loading="lazy" style={`object-position:${ch.imageFocus || 'center top'}`} />}
          <div class="wd-chapter-main">
            <span class="wd-era">{pad(i + 1)} / {pad(chapters.length)} &middot; {ch.era}</span>
            <h3>{ch.headline}</h3>
            <p class="wd-carry"><span>Carried forward</span><strong>{ch.ability}</strong> {ch.abilityDetail.replace(/^\+\s*/, '')}</p>
            <p>{ch.thesis}</p>
          </div>
          <div class="wd-chapter-side">
            <ul class="wd-highlights">{ch.highlights.map((h) => <li>{h}</li>)}</ul>
            <ul class="wd-chips">{ch.branches.map((b) => <li class={`is-${b.kind}`}><em>{b.kind}</em><strong>{b.label}</strong><span>{b.detail}</span></li>)}</ul>
          </div>
        </article>
      ))}
      <p class="wd-pattern">Sales taught trust. Ownership taught risk. Teaching taught clarity. Microsoft is where they compound.</p>
    </div>
  </section>

  <section class="wd-slide is-dark" id="signal-voices" data-signal-section data-presentation-title="Voices" aria-labelledby="signal-voices-title">
    <header class="wd-head">
      <span class="wd-kicker">{kicker('signal-voices', 'Voices Around the Work')}</span>
      <h2 id="signal-voices-title">Credibility compounds when other people say it for you.</h2>
      <p>Captured from Microsoft leadership, sales peers, and cross-org partners.</p>
    </header>
    <ul class="wd-grid wd-voices">
      {voices.map((v) => (
        <li style={`--hue:${v.hue}`}>
          <span class="wd-orb" aria-hidden="true">{v.init}</span>
          <span class="wd-voice-role">{v.role}</span>
          <blockquote set:html={v.quote} />
          <cite><strong>{v.name}</strong>{v.title}</cite>
        </li>
      ))}
    </ul>
  </section>

  <section class="wd-slide is-dark wd-ask" id="signal-ask" data-signal-section data-presentation-title="Next" aria-labelledby="signal-ask-title">
    <header class="wd-head">
      <span class="wd-kicker">{kicker('signal-ask', 'The Next Seat')}</span>
      <h2 id="signal-ask-title">GBB Security, then sales leadership.</h2>
      <p>The seat I want is Solution Sales Advisor on the Security GBB. Be the security expert for a region, coach account teams on pipeline and deal shaping, own the C-level relationships, and orchestrate the v-team and partners from discovery through pilot. I've done the technical half of that job for two years. The decade before it was the sales half.</p>
    </header>
    <ol class="wd-grid wd-arc" aria-label="Career direction">
      <li><strong>Now</strong><span>Senior Security SE</span></li>
      <li><strong>Target seat</strong><span>Solution Sales Advisor, GBB Security</span></li>
      <li><strong>Proof</strong><span>4 / 4 FY26 buckets &middot; 22 certs &middot; SANS B.P.S.</span></li>
      <li><strong>Then</strong><span>Sales leadership</span></li>
    </ol>
    <a class="wd-link-out" href="/career/career-development-plan/">Open the career development plan</a>
  </section>
</section>

<script>
  import { initWalkingDeck } from '../scripts/walkingDeck.client';
  import { initPresentationDeck } from '../scripts/presentationDeck.client';

  initWalkingDeck();
  initPresentationDeck();
</script>

<style>
  /* Palette: change these and the whole deck follows. */
  .wd {
    /* Palette from the Japanese traditional colors used in the M365 E3/E5/E7 visual. */
    --ink: #1C1C1C;          /* 墨 sumi */
    --muted: #434343;
    --paper: #FCFAF2;        /* 白練 shironeri */
    --night: #0F2540;        /* 紺 kon */
    --night-2: #2B5F75;      /* 藍 ai */
    --on-dark: var(--paper-bright);
    --on-dark-muted: color-mix(in srgb, var(--paper-bright) 72%, transparent);
    --accent: #006284;       /* 縹 hanada */
    --warm: #A5DEE4;         /* 水 mizu: labels and lines on dark */
    --hi: #CC543A;           /* 朱 shu: results and the active chapter only */
    --cool: #91989F;         /* 銀鼠 ginnezumi */
    --line: color-mix(in srgb, currentColor 14%, transparent);
    --radius: 1rem;
    --gap: clamp(0.75rem, 2cqi, 1.5rem);

    display: grid;
    gap: 1.25rem;
    color: var(--ink);
    container: wd / inline-size;
  }

  .wd :is(h2, h3, p, blockquote, ul, ol, figure) { margin: 0; }
  .wd :is(ul, ol) { padding: 0; list-style: none; }
  .wd h2 { font-size: clamp(1.9rem, 5cqi, 3.6rem); line-height: 1.06; text-wrap: balance; }
  .wd h3 { font-size: clamp(1.2rem, 2.6cqi, 1.9rem); line-height: 1.15; text-wrap: balance; }
  .wd p { line-height: 1.6; text-wrap: pretty; }

  /* Rail */
  .wd-rail {
    position: sticky; top: 5rem; z-index: 5;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem;
    width: fit-content; max-width: 100%; margin-inline: auto; padding: 0.35rem;
    border: 1px solid var(--line); border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px);
  }
  .wd-rail a, .wd-present {
    padding: 0.4rem 0.75rem; border: 0; border-radius: 999px;
    color: var(--muted); background: none; font-family: inherit; font-weight: 700; font-size: 0.78rem; line-height: 1; text-decoration: none; cursor: pointer;
  }
  .wd-rail a.is-active { color: var(--paper); background: var(--ink); }
  .wd-present { color: var(--on-dark); background: var(--hi); }

  /* Slides: one layout, sized by its own width */
  .wd-slide {
    container-type: inline-size;
    display: grid; align-content: safe center; gap: var(--gap);
    min-height: min(46rem, 90svh);
    padding: clamp(1.25rem, 5cqi, 3.5rem);
    border-radius: var(--radius);
    scroll-margin-top: 6rem;
  }
  .wd-slide.is-light { background: var(--paper); border: 1px solid var(--line); }
  .wd-slide.is-dark {
    color: var(--on-dark);
    background: radial-gradient(120% 90% at 0% 0%, var(--night-2), var(--night) 60%);
  }
  .wd-slide.is-dark p { color: var(--on-dark-muted); }
  .wd-head { display: grid; gap: 0.75rem; max-width: 52rem; }
  .wd-kicker { color: var(--accent); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .is-dark .wd-kicker { color: var(--warm); }
  .wd-grid { display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min, 15rem)), 1fr)); }
  .wd-grid > li { display: grid; align-content: start; gap: 0.4rem; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: calc(var(--radius) * 0.75); }
  .wd-grid > li > span { color: inherit; opacity: 0.78; line-height: 1.5; }

  /* Intro */
  .wd-collage { display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); }
  .wd-collage figure {
    padding: 0.5rem 0.5rem 0.4rem; background: var(--white); border-radius: 0.3rem;
    box-shadow: 0 14px 34px rgb(0 0 0 / 0.45); transform: rotate(var(--tilt)); transition: transform 0.3s;
  }
  .wd-collage figure:hover { transform: rotate(0) scale(1.03); z-index: 2; }
  .wd-collage img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .wd-collage figcaption { padding-top: 0.35rem; font: 600 1.15rem/1.2 'Caveat', cursive; text-align: center; color: var(--ink); }

  /* Wide intro: copy on the left, the photos scattered on a table to the right. */
  @container wd (min-width: 60rem) {
    .wd-human { grid-template-columns: minmax(16rem, 0.8fr) 1.4fr; align-items: center; column-gap: clamp(1.5rem, 4cqi, 3.5rem); }
    .wd-human .wd-head h2 { font-size: clamp(2.6rem, 6cqi, 4.4rem); }
    .wd-human .wd-head p { font-size: 1.08rem; }
    .wd-human .wd-head::after {
      content: ''; width: 4rem; height: 3px; border-radius: 2px; background: var(--hi);
    }
    .wd-collage {
      grid-template-columns: repeat(6, 1fr); grid-auto-rows: auto; gap: 1.25rem 0; padding: 1.5rem 0.5rem;
    }
    .wd-collage figure { position: relative; padding: 0.6rem 0.6rem 0.5rem; }
    .wd-collage figure:nth-child(1) { grid-column: 1 / 4; grid-row: 1; translate: 4% 6%; }
    .wd-collage figure:nth-child(2) { grid-column: 3 / 6; grid-row: 1; translate: 10% -8%; z-index: 1; }
    .wd-collage figure:nth-child(3) { grid-column: 1 / 3; grid-row: 2; translate: -4% 0; }
    .wd-collage figure:nth-child(4) { grid-column: 3 / 5; grid-row: 2; translate: 4% 6%; z-index: 1; }
    .wd-collage figure:nth-child(5) { grid-column: 5 / 7; grid-row: 2; translate: 0 -2%; }
    .wd-collage figure:nth-child(-n+2) figcaption { font-size: 1.35rem; }
    .wd-collage figure::before {
      content: ''; position: absolute; top: -0.55rem; left: 50%; width: 4.5rem; height: 1.1rem; translate: -50% 0; rotate: calc(var(--tilt) * -1.4);
      background: color-mix(in srgb, var(--warm) 55%, transparent); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
    }
    .wd[data-present='true'] .wd-human.is-current .wd-collage figure { animation: wd-drop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(var(--i) * 90ms + 120ms); }
  }
  @keyframes wd-drop { from { opacity: 0; transform: rotate(calc(var(--tilt) * 3)) scale(1.12); } }

  /* Signal */
  .wd-cover { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); align-items: center; }
  .wd-cover-copy { display: grid; gap: 0.9rem; }
  .wd-role { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-weight: 700; }
  .wd-role span + span { color: var(--warm); letter-spacing: 0.08em; text-transform: uppercase; }
  .wd-toggle { display: inline-flex; padding: 0.2rem; border: 1px solid var(--line); border-radius: 999px; }
  .wd-toggle button { padding: 0.4rem 0.9rem; border: 0; border-radius: 999px; background: none; color: inherit; font-family: inherit; font-weight: 800; font-size: 0.72rem; line-height: 1; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; }
  .wd-toggle .is-active { background: var(--warm); color: var(--night); }
  .wd-pitch { display: grid; gap: 0.75rem; }
