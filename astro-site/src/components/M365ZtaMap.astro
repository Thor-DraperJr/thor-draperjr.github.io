---
// Thor's standalone ZTA map, served from /visuals/ and embedded whole so it stays one source.
const src = '/visuals/m365-zta-map.html?embed=1&v=3';
---

<div class="zta-breakout">
  <figure class="zta-figure">
    <iframe
      src={src}
      title="Interactive Zero Trust architecture map showing which components Microsoft 365 E3, E5, and E7 cover"
      loading="lazy"
      scrolling="no"
      data-zta-frame
    ></iframe>
    <figcaption>
      Ratings are my simplified, opinionated view for discussion, not a licensing statement.
      <a href={'/visuals/m365-zta-map.html'} target="_blank" rel="noopener">Open the map full screen</a>.
    </figcaption>
  </figure>
</div>

<script>
  // Same-origin frame: size it to its content so the page scrolls, not the frame.
  // Only grow/shrink on real content changes; never react to the frame's own resize (that loops).
  const frame = document.querySelector<HTMLIFrameElement>('[data-zta-frame]');
  const size = () => {
    const doc = frame?.contentDocument;
    const wrap = doc?.querySelector<HTMLElement>('.wrap');
    if (!frame || !doc || !wrap) return;
    let last = 0;
    const fit = () => {
      const h = Math.ceil(wrap.getBoundingClientRect().height);
      if (h < 400 || Math.abs(h - last) < 2) return;
      last = h;
      frame.style.height = `${h + frame.offsetHeight - frame.clientHeight}px`;
    };
    fit();
    doc.addEventListener('click', () => setTimeout(fit, 50));
    doc.addEventListener('change', () => setTimeout(fit, 50));
    addEventListener('resize', () => setTimeout(fit, 100));
  };
  frame?.addEventListener('load', size);
  if (frame?.contentDocument?.readyState === 'complete') size();
</script>

<style>
  .zta-breakout {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: min(100vw - 2rem, 96rem);
    margin: 2rem 0;
  }
  .zta-figure { margin: 0; }
  .zta-figure iframe {
    display: block;
    width: 100%;
    height: 1900px;
    border: 1px solid color-mix(in srgb, #BDC0BA 60%, #FFFFFB);
    border-radius: 16px;
    background: #FCFAF2;
  }
  .zta-figure figcaption { margin-top: 0.75rem; font-size: 0.85rem; opacity: 0.8; }
</style>
