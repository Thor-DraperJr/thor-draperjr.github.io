---
import McpSourceRefs from './McpSourceRefs.astro';

const stages = [
  {
    index: '01',
    name: 'Agent runtime',
    role: 'Caller / workstation',
    detail: 'Initiates the MCP tool request on the configured client route.',
    tone: 'caller',
  },
  {
    index: '02',
    name: 'GSA network path',
    role: 'Optional covered egress',
    detail: 'Evaluates user, device, risk and remote HTTP MCP traffic on covered paths.',
    tone: 'network',
  },
  {
    index: '03',
    name: 'APIM gateway endpoint',
    role: 'Service enforcement point',
    detail: 'Validates inbound Entra token, applies tool and rate policy, and attaches outbound authorization.',
    tone: 'gateway',
  },
  {
    index: '04',
    name: 'MCP server',
    role: 'Tool execution',
    detail: 'Runs the authorized MCP tool operation behind its configured boundary.',
    tone: 'origin',
  },
  {
    index: '05',
    name: 'Target system',
    role: 'Data / API origin',
    detail: 'Enforces resource permissions and records the authoritative action.',
    tone: 'origin',
  },
] as const;

const mermaidSource = `flowchart LR
  A[Agent Runtime] -->|Covered egress| B(GSA Network Path)
  B -->|Inbound Entra token| C[APIM Gateway Endpoint]
  C -->|Outbound credential + policy| D[MCP Server]
  D --> E[Target System]`;
---

<figure class="mcp-apim-flow" data-apim-flow aria-labelledby="mcp-apim-flow-heading">
  <header class="apim-flow-header">
    <span class="kicker">Connection path / Gateway vs. network boundary</span>
    <h3 id="mcp-apim-flow-heading">Where APIM enforces control in an MCP connection</h3>
    <p class="takeaway">GSA governs covered client traffic on the network route; APIM governs requests that reach its service endpoint.</p>
  </header>

  <div class="apim-flow-body">
    <ol class="apim-flow-track" aria-label="MCP request path through optional GSA network inspection and APIM gateway enforcement">
      {stages.map((stage) => (
        <li class={`apim-node apim-node--${stage.tone}`}>
          <span class="node-step">{stage.index}</span>
          <strong>{stage.name}</strong>
          <span class="node-role">{stage.role}</span>
          <p>{stage.detail}</p>
        </li>
      ))}
    </ol>

    <div class="apim-handoffs" aria-label="Credential and policy handoffs">
      <div class="handoff-card">
        <span class="handoff-label">Inbound to APIM</span>
        <p>Caller authenticates to the gateway endpoint (for example, an Entra OAuth token validated by APIM policy).</p>
      </div>
      <div class="handoff-card">
        <span class="handoff-label">Outbound from APIM</span>
        <p>APIM mediates backend access with a separately configured credential or token before forwarding to the MCP server.</p>
      </div>
    </div>

    <details class="mermaid-source">
      <summary>Mermaid flowchart syntax</summary>
      <pre><code>{mermaidSource}</code></pre>
    </details>
  </div>

  <figcaption>
    <p>Illustrative control placement across network egress and the API gateway endpoint. Documented capabilities: <McpSourceRefs ids={[1, 2, 11, 63]} /></p>
  </figcaption>
</figure>

<style>
  .mcp-apim-flow {
    --ink: #132235;
    --paper: #fbfaf6;
    position: relative;
    isolation: isolate;
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid #c9c4b8;
    border-radius: 12px;
    overflow: clip;
    font-family: var(--font-sans, 'Manrope', sans-serif);
  }
  .mcp-apim-flow * {
    box-sizing: border-box;
  }
  .mcp-apim-flow :is(p, h3, ol, li, pre) {
    margin: 0;
    color: inherit;
  }
  .apim-flow-header {
    padding: clamp(20px, 2.8vw, 34px);
    background: #132235;
    color: #fbfaf6;
  }
  .kicker {
    color: #a5b8ee;
    font-size: 12px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 800;
  }
  .mcp-apim-flow h3 {
    color: inherit;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.2;
    margin: 0.45rem 0 0.75rem;
  }
  .takeaway {
    font-size: 17px;
    line-height: 1.5;
    max-width: 68ch;
    color: #e6ecf5;
  }
  .apim-flow-body {
    padding: clamp(18px, 2.5vw, 30px);
    display: grid;
    gap: 20px;
  }
  .apim-flow-track {
    list-style: none;
    padding: 0 !important;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }
  .apim-node {
    position: relative;
    padding: 14px;
    border: 1px solid #6e7c89;
    border-radius: 6px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .apim-node + .apim-node {
    margin: 0 !important;
  }
  .apim-node + .apim-node::before {
    content: '→';
    position: absolute;
    left: -20px;
    top: 22px;
    color: #132235;
    font-size: 19px;
    font-weight: 700;
  }
  .apim-node--caller {
    background: #e8effa;
    border-color: #5872a1;
  }
  .apim-node--network {
    background: #f4f1ea;
    border-style: dashed;
  }
  .apim-node--gateway {
    background: #132235;
    border-color: #008fd3;
    border-width: 2px;
    color: #fbfaf6;
  }
  .apim-node--origin {
    border-top: 4px solid #72796b;
    background: #f4f1ea;
  }
  .node-step {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #4f6272;
  }
  .apim-node--gateway .node-step {
    color: #8bd7fb;
  }
  .apim-node strong {
    font-size: 17px;
    line-height: 1.3;
  }
  .node-role {
    font-size: 13px;
    font-weight: 700;
    color: #334e68;
  }
  .apim-node--gateway .node-role {
    color: #a5b8ee;
  }
  .apim-node p {
    font-size: 15px;
    line-height: 1.45;
    margin-top: 2px;
  }
  .apim-handoffs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .handoff-card {
    padding: 14px 16px;
    background: #f4f1ea;
    border-left: 4px solid #008fd3;
    border-radius: 4px;
  }
  .handoff-label {
    display: block;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
    color: #132235;
  }
  .handoff-card p {
    font-size: 15px;
    line-height: 1.5;
  }
  .mermaid-source {
    font-size: 14px;
    color: #334e68;
  }
  .mermaid-source summary {
    cursor: pointer;
    font-weight: 700;
  }
  .mermaid-source pre {
    margin-top: 8px;
    padding: 12px 14px;
    background: #132235;
    color: #fbfaf6;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.45;
  }
  figcaption {
    padding: 16px clamp(18px, 2.5vw, 30px);
    border-top: 1px solid #ccc6b8;
    font-size: 15px;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .apim-flow-track {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .apim-node + .apim-node::before {
      content: '↓';
      left: 16px;
      top: -22px;
    }
    .apim-handoffs {
      grid-template-columns: 1fr;
    }
  }
</style>
