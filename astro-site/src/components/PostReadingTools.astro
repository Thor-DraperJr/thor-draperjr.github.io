---
import type { Post } from '../lib/content';

interface Props {
  headings: Post['headings'];
  renderMode: Post['experience']['renderMode'];
}

const { headings, renderMode } = Astro.props;
const mapHeadings = headings.filter((heading) => heading.depth === 2).slice(0, 8);
const showMap = (renderMode === 'standard' || renderMode === 'inline') && mapHeadings.length >= 4;
---

<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
{showMap && (
  <nav class="reading-map" aria-label="On this page">
    <span class="reading-map-label">Field index</span>
    <ol>
      {mapHeadings.map((heading, index) => (
        <li><a href={`#${heading.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('main article');
  if (bar && article) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const start = article.offsetTop;
      const distance = Math.max(1, article.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      bar.style.setProperty('--reading-progress', String(progress));
    };
    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  }
</script>

<style is:global>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 120;
    height: 3px;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(var(--reading-progress, 0));
    transform-origin: left;
    background: linear-gradient(90deg, var(--accent), #f0b84b);
  }

  .reading-map {
    position: fixed;
    z-index: 20;
    top: 8.5rem;
    right: max(1rem, calc((100vw - 90rem) / 2));
    width: 12.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  .reading-map-label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--muted-foreground);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .reading-map ol {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-map a {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .reading-map a span {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.66rem;
  }

  .reading-map a:hover,
  .reading-map a:focus-visible {
    color: var(--foreground);
  }

  .prose :is(h2, h3, h4) {
    scroll-margin-top: 6rem;
  }

  .heading-anchor {
    margin-left: 0.45rem;
    color: var(--accent);
    font-size: 0.72em;
    font-weight: 600;
    text-decoration: none;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .prose :is(h2, h3, h4):hover .heading-anchor,
  .heading-anchor:focus-visible {
    opacity: 1;
  }

  @media (max-width: 1180px) {
    .reading-map { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .heading-anchor { transition: none; }
  }
</style>
