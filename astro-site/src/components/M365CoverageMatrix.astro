---
import { TIERS, FUNCS, ROWS, DATA, PLATFORM, GLOSSARY } from '../lib/m365Coverage';
const model = { TIERS, FUNCS, ROWS, DATA, PLATFORM, GLOSSARY };
---

<div class="m365-breakout">
  <figure class="mcx" id="m365-coverage" aria-labelledby="mcx-title">
    <header class="mcx-head">
      <div>
        <span class="mcx-eyebrow">Cyber Defense Matrix · NIST CSF 2.0 × asset classes</span>
        <h3 id="mcx-title">What each step up actually covers</h3>
      </div>
      <div class="mcx-controls">
        <div class="mcx-seg" role="group" aria-label="License tier">
          {TIERS.map((t) => <button type="button" data-tier={t} aria-pressed={t === 'E3' ? 'true' : 'false'}>{t}</button>)}
        </div>
        <button type="button" class="mcx-btn" data-play>Play</button>
        <label class="mcx-toggle"><input type="checkbox" data-only-new /> Only improved cells</label>
      </div>
    </header>

    <div class="mcx-kpis" aria-live="polite">
      <div class="mcx-kpi"><span class="lbl">Matrix coverage</span><span class="val" data-k="cov">0%</span><span class="delta" data-k="covd"></span><span class="meter"><i data-k="covm"></i></span></div>
      <div class="mcx-kpi"><span class="lbl">Cells fully covered</span><span class="val" data-k="full">0 / 36</span><span class="delta" data-k="fulld"></span></div>
      <div class="mcx-kpi"><span class="lbl">Improved by this step</span><span class="val" data-k="new">-</span><span class="delta" data-k="newd"></span></div>
    </div>

    <div class="mcx-main">
      <div class="mcx-scroll" tabindex="0" aria-label="Coverage matrix, scroll horizontally on small screens">
        <div class="mcx-matrix" data-matrix></div>
      </div>
      <aside class="mcx-detail" data-detail>
        <div class="crumb">Cell details</div>
        <h4>Select a cell</h4>
        <p class="empty">Select any cell to see which products cover it at each tier.</p>
      </aside>
    </div>

    <div class="mcx-legend">
      <span><i class="sw none"></i>No coverage</span>
      <span><i class="sw partial"></i>Partial</span>
      <span><i class="sw e3"></i>Full from E3</span>
      <span><i class="sw e5"></i>Full from E5</span>
      <span><i class="sw e7"></i>Full from E7</span>
      <span><i class="sw gain"></i>Improved by this step</span>
    </div>

    <details class="mcx-fold" open>
      <summary>Coverage climb by asset class</summary>
      <p class="hint">Full cell = 1, partial = ½. Segments show what each tier adds to the row.</p>
      <div class="mcx-climb" data-climb></div>
    </details>

    <details class="mcx-fold">
      <summary>Platform layer: what makes every cell work together</summary>
      <div class="mcx-band" data-band></div>
    </details>

    <details class="mcx-fold" data-glossary-fold>
      <summary>Acronym glossary <span class="count">({GLOSSARY.length} terms)</span></summary>
      <p class="hint">Hover or focus any dotted acronym above for a quick definition. Alt+click one inside a cell to jump here.</p>
      <div class="mcx-gtools">
        <input type="search" data-gq placeholder="Search, e.g. ICES, DEX, CTEM" aria-label="Search glossary" />
        <span data-gfilters></span>
        <span class="gcount" data-gcount></span>
      </div>
      <div class="mcx-glist" data-glist></div>
    </details>

    <figcaption>
      Ratings are my simplified, opinionated view for discussion, not a licensing statement.      Recover for networks is out of scope for Microsoft 365 suites; Microsoft 365 Backup is a separate purchase.
      Palette: NOSHIMEHANA 熨斗目花 from <a href="https://nipponcolors.com/">Nippon Colors</a>, climbing KAMENOZOKI → NOSHIMEHANA → KON, with AKE marking what is new.
    </figcaption>
    <div class="mcx-tip" role="tooltip" data-tip></div>
  </figure>
</div>

<script type="application/json" id="m365-coverage-data" set:html={JSON.stringify(model)} />

<script>
  type Tier = 'E3' | 'E5' | 'E7';
  const root = document.getElementById('m365-coverage');
  const raw = document.getElementById('m365-coverage-data');
  if (root && raw) {
    const { TIERS, FUNCS, ROWS, DATA, PLATFORM, GLOSSARY } = JSON.parse(raw.textContent || '{}');
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const k = (s: string) => $(`[data-k="${s}"]`);
    const idx = (t: Tier) => TIERS.indexOf(t);
    const prevTier = (t: Tier): Tier | null => (idx(t) > 0 ? TIERS[idx(t) - 1] : null);
    const levelAt = (c: any, t: Tier) => c.lv[idx(t)];
    const firstFull = (c: any) => TIERS.find((t: Tier) => levelAt(c, t) === 2);
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const GMAP: Record<string, any> = Object.fromEntries(GLOSSARY.map(([grp, ac, full, plain, ms]: string[]) => [ac, { grp, ac, full, plain, ms }]));
    const GRX = new RegExp('(?<![A-Za-z0-9-])(' + Object.keys(GMAP).sort((a, b) => b.length - a.length).map((x) => x.replace(/-/g, '\\-')).join('|') + ')(?![A-Za-z0-9-])', 'g');
    const annotate = (s: string) => esc(s).replace(GRX, (m) => `<abbr data-term="${m}" tabindex="0">${m}</abbr>`);

    let current: Tier = 'E3';
    let selected: { r: string; ci: number } | null = null;

    const matrix = $('[data-matrix]');
    matrix.innerHTML = '<div></div>' + FUNCS.map(([f, s]: string[]) => `<div class="colh">${f}<small>${s}</small></div>`).join('');
    ROWS.forEach(([r, s]: string[]) => {
      matrix.insertAdjacentHTML('beforeend', `<div class="rowh${r === 'AI Agents' ? ' new-row' : ''}">${esc(r)}<small>${s}</small></div>`);
      DATA[r].forEach((_: any, ci: number) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cell';
        b.dataset.row = r;
        b.dataset.col = String(ci);
        b.innerHTML = '<span class="tag"></span><span class="badge"></span>';
        b.addEventListener('click', (e) => {
          if ((e as MouseEvent).altKey && (e.target as HTMLElement).closest('abbr')) return;
          selected = { r, ci };
          render();
        });
        matrix.appendChild(b);
      });
    });

    function render() {
      root!.querySelectorAll<HTMLButtonElement>('.mcx-seg button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tier === current)));
      const prev = prevTier(current);
      let total = 0, prevTotal = 0, full = 0, prevFull = 0, gained = 0;
      root!.querySelectorAll<HTMLElement>('.cell').forEach((el) => {
        const cell = DATA[el.dataset.row!][+el.dataset.col!];
        const lv = levelAt(cell, current);
        const plv = prev ? levelAt(cell, prev) : 0;
        total += lv / 2; if (lv === 2) full++;
        if (prev) { prevTotal += plv / 2; if (plv === 2) prevFull++; }
        const isGain = !!prev && lv > plv;
        if (isGain) gained++;
        el.className = 'cell';
        if (lv === 1) el.classList.add('partial');
        if (lv === 2) el.classList.add('full-' + firstFull(cell));
        if (isGain) el.classList.add('gained');
        if (selected && selected.r === el.dataset.row && selected.ci === +el.dataset.col!) el.classList.add('selected');
        el.querySelector('.tag')!.innerHTML = lv === 0 ? '-' : annotate(cell.tag[idx(current)]);
        el.querySelector('.badge')!.textContent = lv === 2 ? 'Full' : lv === 1 ? 'Partial' : 'Gap';
        el.setAttribute('aria-label', `${el.dataset.row}, ${FUNCS[+el.dataset.col!][0]}: ${lv === 2 ? 'full' : lv === 1 ? 'partial' : 'no'} coverage at ${current}`);
      });
      const n = 36, pct = Math.round((total / n) * 100);
      k('cov').textContent = pct + '%';
      k('covm').style.width = pct + '%';
      k('covd').textContent = prev ? `+${pct - Math.round((prevTotal / n) * 100)} pts vs ${prev}` : 'Starting point';
      k('full').textContent = `${full} / ${n}`;
      k('fulld').textContent = prev ? `+${full - prevFull} vs ${prev}` : '';
      k('new').textContent = prev ? String(gained) : '-';
      k('newd').textContent = prev ? `cells improved from ${prev}` : 'Pick E5 or E7';
      renderClimb(); renderBand(); renderDetail();
    }

    function renderClimb() {
      $('[data-climb]').innerHTML = ROWS.map(([r]: string[]) => {
        const s = (t: Tier) => (DATA[r].reduce((a: number, c: any) => a + levelAt(c, t) / 2, 0) / DATA[r].length) * 100;
        const segs = TIERS.map((t: Tier, i: number) => (i > idx(current) ? 0 : s(t) - (i ? s(TIERS[i - 1]) : 0)));
        const tot = s(current);
        return `<div class="rl">${esc(r)}</div>
          <div class="bar" role="img" aria-label="${esc(r)}: ${Math.round(tot)}% at ${current}">
            <i class="e3" style="width:${segs[0]}%"></i><i class="e5" style="width:${segs[1]}%"></i><i class="e7" style="width:${segs[2]}%"></i>
          </div><div class="pct">${Math.round(tot)}%</div>`;
      }).join('');
    }

    function renderBand() {
      $('[data-band]').innerHTML = TIERS.map((t: Tier) => `
        <div class="tier t-${t} ${idx(t) > idx(current) ? 'locked' : ''}">
          <h5>${t === 'E3' ? 'E3 foundation' : t + ' adds'}</h5>
          ${PLATFORM[t].map((x: string) => `<span class="chip">${annotate(x)}</span>`).join('')}
        </div>`).join('');
    }

    function renderDetail() {
      if (!selected) return;
      const cell = DATA[selected.r][selected.ci];
      const lv = levelAt(cell, current);
      const status = lv === 2 ? `Full coverage (from ${firstFull(cell)})` : lv === 1 ? 'Partial coverage' : 'No coverage at this tier';
      $('[data-detail]').innerHTML = `
        <div class="crumb">${esc(selected.r)} · ${FUNCS[selected.ci][0]}</div>
        <h4>${lv === 0 ? 'No coverage' : annotate(cell.tag[idx(current)])}</h4>
        <div class="status">${current}: ${status}</div>
        ${TIERS.map((t: Tier) => {
          const items = cell.items[t];
          const on = idx(t) <= idx(current);
          return `<div class="tierblock ${on ? 'on' : 'off'}"><div class="tn">${t}${t === 'E3' ? '' : ' adds'}${on ? '' : ' (locked)'}</div>
            ${items.length ? `<ul>${items.map((i: string) => `<li>${annotate(i)}</li>`).join('')}</ul>` : '<div class="empty">Nothing new at this tier</div>'}</div>`;
        }).join('')}
        ${selected.r === 'AI Agents' ? '<p class="hint">E5 customers can add Agent 365. From June 1, 2026, E3 alone does not qualify for new Agent 365 purchases.</p>' : ''}`;
    }

    // Glossary (collapsed by default)
    const fold = $('[data-glossary-fold]') as HTMLDetailsElement;
    const gq = $('[data-gq]') as HTMLInputElement;
    let gGroup = 'All';
    const groups = ['All', ...new Set(GLOSSARY.map((g: string[]) => g[0]))] as string[];
    const gf = $('[data-gfilters]');
    gf.innerHTML = groups.map((g) => `<button type="button" class="gfilter" data-g="${g}" aria-pressed="${g === gGroup}">${g}</button>`).join(' ');
    gf.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.gfilter'); if (!b) return;
      gGroup = b.dataset.g!;
      gf.querySelectorAll<HTMLElement>('.gfilter').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.g === gGroup)));
      renderGlossary();
    });
    gq.addEventListener('input', renderGlossary);
    function renderGlossary() {
      const q = gq.value.trim().toLowerCase();
      const rows = Object.values(GMAP)
        .filter((g) => gGroup === 'All' || g.grp === gGroup)
        .filter((g) => !q || [g.ac, g.full, g.plain, g.ms].join(' ').toLowerCase().includes(q))
        .sort((a, b) => a.ac.localeCompare(b.ac));
      $('[data-gcount]').textContent = `${rows.length} of ${GLOSSARY.length}`;
      $('[data-glist]').innerHTML = rows.map((g) => `
        <div class="gitem" data-term-entry="${g.ac}"><span class="grp">${g.grp}</span><div class="ac">${g.ac}</div>
        <div class="fn">${esc(g.full)}</div><div>${esc(g.plain)}</div><div class="ms">In Microsoft 365: ${esc(g.ms)}</div></div>`).join('');
    }
    renderGlossary();

    const tip = $('[data-tip]');
    function showTip(a: HTMLElement) {
      const g = GMAP[a.dataset.term!]; if (!g) return;
      tip.innerHTML = `<b>${g.ac}: ${esc(g.full)}</b>${esc(g.plain)}<div class="ms">In Microsoft 365: ${esc(g.ms)}</div>`;
      tip.classList.add('show');
      const r = a.getBoundingClientRect(), tw = tip.offsetWidth, th = tip.offsetHeight;
      const x = Math.min(Math.max(8, r.left + r.width / 2 - tw / 2), innerWidth - tw - 8);
      let y = r.top - th - 8; if (y < 8) y = r.bottom + 8;
      tip.style.left = x + 'px'; tip.style.top = y + 'px';
    }
    const hideTip = () => tip.classList.remove('show');
    root.addEventListener('mouseover', (e) => { const a = (e.target as HTMLElement).closest<HTMLElement>('abbr[data-term]'); a ? showTip(a) : hideTip(); });
    root.addEventListener('mouseleave', hideTip);
    root.addEventListener('focusin', (e) => { const a = (e.target as HTMLElement).closest<HTMLElement>('abbr[data-term]'); a ? showTip(a) : hideTip(); });
    document.addEventListener('scroll', hideTip, true);
    function jumpTo(term: string) {
      fold.open = true;
      gGroup = 'All'; gq.value = '';
      gf.querySelectorAll<HTMLElement>('.gfilter').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.g === 'All')));
      renderGlossary();
      const el = root!.querySelector<HTMLElement>(`[data-term-entry="${CSS.escape(term)}"]`); if (!el) return;
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 1600);
      hideTip();
    }
    root.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('abbr[data-term]');
      if (!a || (!(e as MouseEvent).altKey && a.closest('.cell'))) return;
      jumpTo(a.dataset.term!);
    });
    root.addEventListener('keydown', (e) => {
      const a = (e.target as HTMLElement).closest?.<HTMLElement>('abbr[data-term]');
      if (a && e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); jumpTo(a.dataset.term!); }
    });

    $('[data-only-new]').addEventListener('change', (e) => root.classList.toggle('only-new', (e.target as HTMLInputElement).checked));

    let timer: number | null = null;
    const playBtn = $('[data-play]');
    const stopPlay = () => { if (timer) { clearInterval(timer); timer = null; } playBtn.textContent = 'Play'; };
    root.querySelectorAll<HTMLButtonElement>('.mcx-seg button').forEach((b) => b.addEventListener('click', () => { stopPlay(); current = b.dataset.tier as Tier; render(); }));
    playBtn.addEventListener('click', () => {
      if (timer) return stopPlay();
      let i = 0; current = TIERS[0]; render();
      playBtn.textContent = 'Stop';
      timer = window.setInterval(() => {
        i++;
        if (i >= TIERS.length) return stopPlay();
        current = TIERS[i]; render();
        if (i === TIERS.length - 1) stopPlay();
      }, 1800);
    });

    render();
  }
</script>

<style is:global>
  /* NOSHIMEHANA scheme: every value is a named color from Nippon Colors (nipponcolors.com). Scoped to the figure. */
  .m365-breakout { position: relative; left: 50%; width: min(100vw - 2rem, 76rem); margin: 2.5rem 0; transform: translateX(-50%); }
  .mcx {
    --bg: #FCFAF2; --surface: #FFFFFB; --soft: color-mix(in srgb, #BDC0BA 22%, #FFFFFB);
    --border: color-mix(in srgb, #BDC0BA 60%, #FFFFFB); --border-strong: #91989F;
    --text: #1C1C1C; --muted: #434343; --faint: #656765;
    --accent: #2B5F75; --accent-soft: rgba(43, 95, 117, 0.09); --accent-fg: #FFFFFB; --link: #006284;
    --e3: #A5DEE4; --e5: #2B5F75; --e7: #0F2540; --e3-fg: #0F2540; --e5-fg: #FFFFFB; --e7-fg: #FFFFFB;
    --hi: #CC543A; --partial: color-mix(in srgb, #A5DEE4 45%, #FFFFFB);
    --shadow: 0 0 2px rgba(8,25,45,0.12), 0 1px 2px rgba(8,25,45,0.14);
    --tip-bg: rgba(255, 255, 251, 0.97);
    margin: 0; padding: clamp(1rem, 2.5vw, 1.75rem); border-radius: 18px; border: 1px solid var(--border);
    background: var(--bg); color: var(--text); font-size: 14px; line-height: 1.45;
    font-family: "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .mcx * { box-sizing: border-box; }
  .mcx a { color: var(--link); }
  .mcx-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; }
  .mcx-eyebrow { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.35rem; }
  .mcx-head h3 { margin: 0; font-size: 1.3rem; font-weight: 600; color: var(--text); }
  .mcx-controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .mcx-seg { display: inline-flex; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 4px; box-shadow: var(--shadow); }
  .mcx-seg button { border: 0; background: transparent; color: var(--text); font: inherit; font-weight: 600; padding: 7px 14px; border-radius: 8px; cursor: pointer; transition: background .2s, color .2s; }
  .mcx-seg button:hover { background: var(--accent-soft); }
  .mcx-seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); }
  .mcx-btn { border: 1px solid var(--border); background: var(--surface); color: var(--text); font: inherit; padding: 7px 14px; border-radius: 10px; cursor: pointer; box-shadow: var(--shadow); }
  .mcx-btn:hover { border-color: var(--accent); color: var(--accent); }
  .mcx-toggle { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); cursor: pointer; user-select: none; font-size: 13px; }

  .mcx-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 1rem; }
  .mcx-kpi { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 12px 14px; box-shadow: var(--shadow); }
  .mcx-kpi .lbl { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
  .mcx-kpi .val { font-size: 26px; font-weight: 700; }
  .mcx-kpi .delta { color: var(--accent); font-weight: 600; font-size: 12px; min-height: 1.2em; }
  .mcx-kpi .meter { height: 6px; background: var(--soft); border-radius: 3px; margin-top: 6px; overflow: hidden; }
  .mcx-kpi .meter i { display: block; height: 100%; background: var(--accent); width: 0; transition: width .6s ease; }

  .mcx-main { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 14px; align-items: start; }
  .mcx-scroll { overflow-x: auto; }
  .mcx-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mcx-matrix { display: grid; grid-template-columns: 112px repeat(6, minmax(88px, 1fr)); gap: 6px; min-width: 680px; }
  .mcx .colh { text-align: center; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); padding: 4px 0; }
  .mcx .colh small, .mcx .rowh small { display: block; text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--faint); font-size: 11px; }
  .mcx .rowh { display: flex; flex-direction: column; justify-content: center; font-weight: 600; padding-right: 6px; }
  .mcx .rowh.new-row::after { content: "New asset class"; font-size: 10px; color: var(--hi); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .mcx .cell {
    position: relative; min-height: 74px; border-radius: 10px; border: 1px dashed var(--border-strong); background: var(--soft);
    padding: 6px 8px; cursor: pointer; text-align: left; font: inherit; color: var(--text);
    transition: background .5s ease, border-color .5s ease, transform .15s, box-shadow .3s, opacity .3s;
    display: flex; flex-direction: column; justify-content: space-between; overflow: hidden;
  }
  .mcx .cell:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
  .mcx .cell:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mcx .cell .tag { font-size: 11px; line-height: 1.25; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; padding-right: 16px; }
  .mcx .cell .badge { align-self: flex-end; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: var(--surface); color: var(--text); border: 1px solid var(--border); }
  .mcx .cell.partial { border-style: solid; border-color: var(--border); background: repeating-linear-gradient(135deg, var(--partial) 0 5px, var(--surface) 5px 10px); }
  .mcx .cell.full-E3 { border: 1px solid transparent; background: var(--e3); }
  .mcx .cell.full-E5 { border: 1px solid transparent; background: var(--e5); }
  .mcx .cell.full-E7 { border: 1px solid transparent; background: var(--e7); }
  .mcx .cell.partial .tag { color: var(--text); }
  .mcx .cell.full-E3 .tag { color: var(--e3-fg); }
  .mcx .cell.full-E5 .tag { color: var(--e5-fg); }
  .mcx .cell.full-E7 .tag { color: var(--e7-fg); }
  .mcx .cell.gained { box-shadow: 0 0 0 2px var(--hi), var(--shadow); }
  .mcx .cell.gained::before { content: "+"; position: absolute; top: 4px; right: 6px; font-weight: 800; color: var(--hi); background: var(--surface); border-radius: 999px; width: 16px; height: 16px; line-height: 16px; text-align: center; font-size: 12px; }
  .mcx .cell.selected { outline: 2px solid var(--text); outline-offset: 2px; }
  .mcx.only-new .cell:not(.gained) { opacity: .28; }

  .mcx-detail { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 14px; box-shadow: var(--shadow); position: sticky; top: 1rem; }
  .mcx-detail h4 { margin: 0; font-size: 15px; color: var(--text); }
  .mcx-detail .crumb { color: var(--muted); font-size: 12px; margin-bottom: 6px; }
  .mcx-detail .status { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); margin: 6px 0 4px; }
  .mcx .tierblock { border-left: 3px solid var(--border); padding: 4px 0 4px 10px; margin: 8px 0; }
  .mcx .tierblock.on { border-left-color: var(--accent); }
