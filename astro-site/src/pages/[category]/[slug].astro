---
import Layout from '../../layouts/Layout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import PostHeader from '../../components/PostHeader.astro';
import PostPagination from '../../components/PostPagination.astro';
import { render } from 'astro:content';
import { getPosts } from '../../lib/content';

export function getStaticPaths() {
  const posts = getPosts();

  return posts.map((post, index) => ({
    params: { category: post.category, slug: post.slug },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post.entry);
---

<Layout
  pageTitle={post.title}
  pageDescription={post.excerpt}
  currentPath={post.permalink}
  pageType="article"
  socialImage={`/social/${post.category}/${post.slug}.png`}
  publishedTime={post.date.toISOString()}
>
  <article class="article-grid prose">
    <PostHeader post={post} showPresentAction={Boolean(post.presentHref)} />
    <ArticleBody post={post}><Content /></ArticleBody>
    <PostPagination previous={previous} next={next} />
  </article>
</Layout>
