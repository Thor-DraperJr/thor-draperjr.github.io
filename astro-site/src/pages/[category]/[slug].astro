---
import Layout from '../../layouts/Layout.astro';
import RuntimeControlChart from '../../components/RuntimeControlChart.astro';
import CareerDevelopmentPlan from '../../components/CareerDevelopmentPlan.astro';
import CharlotteArtsMap from '../../components/CharlotteArtsMap.astro';
import WalkingDeck from '../../components/WalkingDeck.astro';
import AllAboardSlide from '../../components/AllAboardSlide.astro';
import ThreeNewYears from '../../components/ThreeNewYears.astro';
import PerformanceNarrative from '../../components/PerformanceNarrative.astro';
import GitHubFlowModernized from '../../components/GitHubFlowModernized.astro';
import AgentActionLoop from '../../components/AgentActionLoop.astro';
import WorkshopObjectives from '../../components/WorkshopObjectives.astro';
import SessionRunOfShow from '../../components/SessionRunOfShow.astro';
import WhatIsGitHub from '../../components/WhatIsGitHub.astro';
import WorkshopTools from '../../components/WorkshopTools.astro';
import DiffPreview from '../../components/DiffPreview.astro';
import PresentationWorkflowMap from '../../components/PresentationWorkflowMap.astro';
import CopilotVisualWorkflow from '../../components/CopilotVisualWorkflow.astro';
import AgenticSocialLoop from '../../components/AgenticSocialLoop.astro';
import GatewayProcessMap from '../../components/GatewayProcessMap.astro';
import AgentHarnessLayers from '../../components/AgentHarnessLayers.astro';
import CareerSignalMap from '../../components/CareerSignalMap.astro';
import TokenSilos from '../../components/TokenSilos.astro';
import PostHeader from '../../components/PostHeader.astro';
import PostPagination from '../../components/PostPagination.astro';
import { getPosts } from '../../lib/content';

export function getStaticPaths() {
  const posts = getPosts();

  return posts.map((post, index) => ({
    params: {
      category: post.category,
      slug: post.slug,
    },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;

const runtimeChartMarker = '[[RUNTIME_CONTROL_CHART]]';
const careerDevPlanMarker = '[[CAREER_DEV_PLAN]]';
const charlotteArtsMapMarker = '[[CHARLOTTE_ARTS_MAP]]';
const walkingDeckMarker = '[[WALKING_DECK]]';
const allAboardMarker = '[[ALL_ABOARD]]';
const allAboardSlideMarkers = ['03', '04', '05', '06', '07', '08', '09', '10', '11', '12', '13', '14'].map(
  (n) => `[[SLIDE_${n}]]`,
);
const threeNewYearsMarker = '[[THREE_NEW_YEARS]]';
const performanceNarrativeMarker = '[[PERFORMANCE_NARRATIVE]]';
const ghWorkshopMarker = '[[GH_WORKSHOP]]';
const ghWorkshopFigureMarkers = ['WHAT_IS_GITHUB', 'GITHUB_FLOW', 'YOUR_TOOLS', 'AGENT_LOOP', 'DIFF_PREVIEW', 'WORKSHOP_OBJECTIVES', 'SESSION_PLAN'].map((n) => `[[${n}]]`);
const presentationWorkflowMapMarker = '[[PRESENTATION_WORKFLOW]]';
const presentationWorkflowMarkers = ['ASK', 'RULES', 'TEAM', 'PROOF', 'GATE'].map((name) => `[[PRESENTATION_WORKFLOW_${name}]]`);
const socialLoopMarker = '[[SOCIAL_LOOP]]';
const gatewayProcessMapMarker = '[[GATEWAY_PROCESS_MAP]]';
const agentHarnessLayersMarker = '[[AGENT_HARNESS_LAYERS]]';
const careerSignalMapMarker = '[[CAREER_SIGNAL_MAP]]';
const tokenSilosMarker = '[[TOKEN_SILOS]]';

let processedHtml = post.html;
processedHtml = processedHtml.replace(`<p>${runtimeChartMarker}</p>`, runtimeChartMarker);
processedHtml = processedHtml.replace(`<p>${careerDevPlanMarker}</p>`, careerDevPlanMarker);
processedHtml = processedHtml.replace(`<p>${charlotteArtsMapMarker}</p>`, charlotteArtsMapMarker);
processedHtml = processedHtml.replace(`<p>${walkingDeckMarker}</p>`, walkingDeckMarker);
processedHtml = processedHtml.replace(`<p>${allAboardMarker}</p>`, allAboardMarker);
for (const slideMarker of allAboardSlideMarkers) {
  processedHtml = processedHtml.replace(`<p>${slideMarker}</p>`, slideMarker);
}
processedHtml = processedHtml.replace(`<p>${threeNewYearsMarker}</p>`, threeNewYearsMarker);
processedHtml = processedHtml.replace(`<p>${performanceNarrativeMarker}</p>`, performanceNarrativeMarker);
processedHtml = processedHtml.replace(`<p>${ghWorkshopMarker}</p>`, ghWorkshopMarker);
for (const figureMarker of ghWorkshopFigureMarkers) {
  processedHtml = processedHtml.replace(`<p>${figureMarker}</p>`, figureMarker);
}
processedHtml = processedHtml.replace(`<p>${presentationWorkflowMapMarker}</p>`, presentationWorkflowMapMarker);
for (const workflowMarker of presentationWorkflowMarkers) {
  processedHtml = processedHtml.replace(`<p>${workflowMarker}</p>`, workflowMarker);
}
processedHtml = processedHtml.replace(`<p>${socialLoopMarker}</p>`, socialLoopMarker);
processedHtml = processedHtml.replace(`<p>${gatewayProcessMapMarker}</p>`, gatewayProcessMapMarker);
processedHtml = processedHtml.replace(`<p>${agentHarnessLayersMarker}</p>`, agentHarnessLayersMarker);
processedHtml = processedHtml.replace(`<p>${careerSignalMapMarker}</p>`, careerSignalMapMarker);
processedHtml = processedHtml.replace(`<p>${tokenSilosMarker}</p>`, tokenSilosMarker);

const hasRuntimeChart = processedHtml.includes(runtimeChartMarker);
const hasCareerDevPlan = processedHtml.includes(careerDevPlanMarker);
const hasCharlotteArtsMap = processedHtml.includes(charlotteArtsMapMarker);
const hasWalkingDeck = processedHtml.includes(walkingDeckMarker);
const hasAllAboard = processedHtml.includes(allAboardMarker);
const hasThreeNewYears = processedHtml.includes(threeNewYearsMarker);
const hasPerformanceNarrative = processedHtml.includes(performanceNarrativeMarker);
const hasPresentationWorkflowMap = processedHtml.includes(presentationWorkflowMapMarker);
const hasPresentationWorkflow = presentationWorkflowMarkers.some((marker) => processedHtml.includes(marker));
const hasWebsitePresentation = hasPresentationWorkflow && post.presentation === 'website-presentation';
const hasSocialLoop = processedHtml.includes(socialLoopMarker);
const hasGatewayProcessMap = processedHtml.includes(gatewayProcessMapMarker);
const hasAgentHarnessLayers = processedHtml.includes(agentHarnessLayersMarker);
const hasCareerSignalMap = processedHtml.includes(careerSignalMapMarker);
const hasTokenSilos = processedHtml.includes(tokenSilosMarker);

const runtimeParts = hasRuntimeChart ? processedHtml.split(runtimeChartMarker) : [];
const careerParts = hasCareerDevPlan ? processedHtml.split(careerDevPlanMarker) : [];
const charlotteArtsMapParts = hasCharlotteArtsMap ? processedHtml.split(charlotteArtsMapMarker) : [];
const walkingDeckParts = hasWalkingDeck ? processedHtml.split(walkingDeckMarker) : [];
const allAboardParts = hasAllAboard ? processedHtml.split(allAboardMarker) : [];
// Everything after the [[ALL_ABOARD]] gate is prose with embedded figure
// markers (SLIDE_xx). Walk it once and
// build an ordered list of prose/figure segments so the talk reads top to
// bottom: speak, show the slide, keep speaking.
const allAboardBody = hasAllAboard ? allAboardParts.slice(1).join(allAboardMarker) : '';
const allAboardMarkerRegex = /\[\[SLIDE_\d{2}\]\]/g;
const allAboardSegments: Array<{ kind: 'html' | 'marker'; value: string }> = [];
if (hasAllAboard) {
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = allAboardMarkerRegex.exec(allAboardBody)) !== null) {
    if (match.index > lastIndex) {
      allAboardSegments.push({ kind: 'html', value: allAboardBody.slice(lastIndex, match.index) });
    }
    allAboardSegments.push({ kind: 'marker', value: match[0] });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < allAboardBody.length) {
    allAboardSegments.push({ kind: 'html', value: allAboardBody.slice(lastIndex) });
  }
}
const threeNewYearsParts = hasThreeNewYears ? processedHtml.split(threeNewYearsMarker) : [];
const performanceNarrativeParts = hasPerformanceNarrative ? processedHtml.split(performanceNarrativeMarker) : [];
const presentationWorkflowMapParts = hasPresentationWorkflowMap ? processedHtml.split(presentationWorkflowMapMarker) : [];
const presentationWorkflowMarkerRegex = /\[\[PRESENTATION_WORKFLOW_(?:ASK|RULES|TEAM|PROOF|GATE)\]\]/g;
const presentationWorkflowSegments: Array<{ kind: 'html' | 'marker'; value: string }> = [];
if (hasWebsitePresentation) {
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = presentationWorkflowMarkerRegex.exec(processedHtml)) !== null) {
    if (match.index > lastIndex) {
      presentationWorkflowSegments.push({ kind: 'html', value: processedHtml.slice(lastIndex, match.index) });
    }
    presentationWorkflowSegments.push({ kind: 'marker', value: match[0] });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < processedHtml.length) {
    presentationWorkflowSegments.push({ kind: 'html', value: processedHtml.slice(lastIndex) });
  }
}
const socialLoopParts = hasSocialLoop ? processedHtml.split(socialLoopMarker) : [];
const gatewayProcessMapParts = hasGatewayProcessMap ? processedHtml.split(gatewayProcessMapMarker) : [];
const agentHarnessLayersParts = hasAgentHarnessLayers ? processedHtml.split(agentHarnessLayersMarker) : [];
const careerSignalMapParts = hasCareerSignalMap ? processedHtml.split(careerSignalMapMarker) : [];
const tokenSilosParts = hasTokenSilos ? processedHtml.split(tokenSilosMarker) : [];

const hasGhWorkshop = processedHtml.includes(ghWorkshopMarker);
const ghWorkshopParts = hasGhWorkshop ? processedHtml.split(ghWorkshopMarker) : [];
const ghWorkshopBody = hasGhWorkshop ? ghWorkshopParts.slice(1).join(ghWorkshopMarker) : '';
const ghWorkshopMarkerRegex = /\[\[(?:WHAT_IS_GITHUB|GITHUB_FLOW|YOUR_TOOLS|AGENT_LOOP|DIFF_PREVIEW|WORKSHOP_OBJECTIVES|SESSION_PLAN)\]\]/g;
const ghWorkshopSegments: Array<{ kind: 'html' | 'marker'; value: string }> = [];
if (hasGhWorkshop) {
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = ghWorkshopMarkerRegex.exec(ghWorkshopBody)) !== null) {
    if (match.index > lastIndex) {
      ghWorkshopSegments.push({ kind: 'html', value: ghWorkshopBody.slice(lastIndex, match.index) });
    }
    ghWorkshopSegments.push({ kind: 'marker', value: match[0] });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < ghWorkshopBody.length) {
    ghWorkshopSegments.push({ kind: 'html', value: ghWorkshopBody.slice(lastIndex) });
  }
}
---

<Layout pageTitle={post.title} pageDescription={post.excerpt} currentPath={post.permalink} pageType="article">
  {hasSocialLoop ? (
    <>
      <article class="shell-container">
        <PostHeader post={post} />

        {socialLoopParts.length > 0 && socialLoopParts[0].trim() && (
          <section class="prose panel">
            <Fragment set:html={socialLoopParts[0]} />
          </section>
        )}
      </article>

      <div class="cdp-breakout">
        <AgenticSocialLoop />
      </div>

      <article class="shell-container">
        {socialLoopParts.length > 1 && (
          <section class="prose panel">
            <Fragment set:html={socialLoopParts.slice(1).join(socialLoopMarker)} />
          </section>
        )}

        <PostPagination previous={previous} next={next} />
      </article>
    </>
  ) : hasGatewayProcessMap ? (
    <>
      <article class="shell-container">
        <PostHeader post={post} />

        {gatewayProcessMapParts.length > 0 && gatewayProcessMapParts[0].trim() && (
          <section class="prose panel">
            <Fragment set:html={gatewayProcessMapParts[0]} />
          </section>
        )}
      </article>

      <div class="walking-deck-breakout">
        <GatewayProcessMap />
      </div>

      <article class="shell-container">
        {gatewayProcessMapParts.length > 1 && (
          <section class="prose panel">
            <Fragment set:html={gatewayProcessMapParts.slice(1).join(gatewayProcessMapMarker)} />
          </section>
        )}

        <PostPagination previous={previous} next={next} />
      </article>
    </>
  ) : hasGhWorkshop ? (
    <>
      <article class="shell-container">
        <PostHeader post={post} showPresentAction={true} />

        {ghWorkshopParts.length > 0 && ghWorkshopParts[0].trim() && (
          <section class="prose panel">
            <Fragment set:html={ghWorkshopParts[0]} />
          </section>
        )}
      </article>

      {ghWorkshopSegments.map((seg) => (
        seg.kind === 'html' ? (
          seg.value.trim() && (
            <article class="shell-container">
              <section class="prose panel">
                <Fragment set:html={seg.value} />
              </section>
            </article>
          )
        ) : seg.value === '[[WHAT_IS_GITHUB]]' ? (
          <div class="walking-deck-breakout">
            <WhatIsGitHub />
          </div>
        ) : seg.value === '[[GITHUB_FLOW]]' ? (
          <div class="walking-deck-breakout">
            <GitHubFlowModernized />
          </div>
        ) : seg.value === '[[YOUR_TOOLS]]' ? (
          <div class="walking-deck-breakout">
            <WorkshopTools />
          </div>
        ) : seg.value === '[[AGENT_LOOP]]' ? (
          <div class="walking-deck-breakout">
            <AgentActionLoop />
          </div>
        ) : seg.value === '[[DIFF_PREVIEW]]' ? (
          <div class="walking-deck-breakout">
            <DiffPreview />
          </div>
        ) : seg.value === '[[WORKSHOP_OBJECTIVES]]' ? (
          <div class="walking-deck-breakout">
            <WorkshopObjectives />
          </div>
        ) : seg.value === '[[SESSION_PLAN]]' ? (
          <div class="walking-deck-breakout">
            <SessionRunOfShow />
          </div>
        ) : (
          null
        )
      ))}

      <article class="shell-container">
        <PostPagination previous={previous} next={next} />
      </article>
    </>
  ) : hasPerformanceNarrative ? (
    <>
      <article class="shell-container">
        <PostHeader post={post} />

        {performanceNarrativeParts.length > 0 && performanceNarrativeParts[0].trim() && (
          <section class="prose panel">
            <Fragment set:html={performanceNarrativeParts[0]} />
          </section>
        )}
      </article>

      <div class="cdp-breakout">
        <PerformanceNarrative />
      </div>

      <article class="shell-container">
        {performanceNarrativeParts.length > 1 && (
          <section class="prose panel">
            <Fragment set:html={performanceNarrativeParts.slice(1).join(performanceNarrativeMarker)} />
          </section>
        )}

        <PostPagination previous={previous} next={next} />
      </article>
    </>
  ) : hasCareerDevPlan ? (
    <>
      <article class="shell-container">
        <PostHeader post={post} />
      </article>

      <div class="cdp-breakout">
        <CareerDevelopmentPlan />
      </div>

      <article class="shell-container">
        {careerParts.length > 1 && (
          <section class="prose panel">
            <Fragment set:html={careerParts.slice(1).join(careerDevPlanMarker)} />
          </section>
        )}

        <PostPagination previous={previous} next={next} />
      </article>
    </>
  ) : hasAllAboard ? (
    <>
      <article class="shell-container">
        <header class="post-hero">
          <span class="eyebrow">{post.category}</span>
          <h1 class="post-heading">{post.title}</h1>
          <div class="post-meta-row">
            <span>{post.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <span>{post.readingTime} min read</span>
          </div>
          {post.tags.length > 0 && (
            <div class="post-tags" style="margin-top: 1rem;">
              {post.tags.map((tag) => <span class="post-tag">{tag}</span>)}
            </div>
          )}
        </header>

        {allAboardParts.length > 0 && allAboardParts[0].trim() && (
          <section class="prose panel">
            <Fragment set:html={allAboardParts[0]} />
          </section>
        )}
      </article>

      {allAboardSegments.map((seg) => (
        seg.kind === 'html' ? (
          seg.value.trim() && (
            <article class="shell-container">
              <section class="prose panel">
                <Fragment set:html={seg.value} />
              </section>
            </article>
          )
        ) : (
          <div class="walking-deck-breakout">
            <AllAboardSlide n={seg.value.slice(8, 10)} />
          </div>
        )
      ))}

      <article class="shell-container">
        <nav class="post-pagination">
          {previous ? (
            <a href={previous.permalink}>
              <span>Older</span>
              {previous.title}
            </a>
          ) : <div></div>}

          {next ? (
            <a href={next.permalink} style="text-align: right;">
              <span>Newer</span>
              {next.title}
            </a>
          ) : <div></div>}
        </nav>
      </article>
    </>
  ) : hasWebsitePresentation ? (
    <>
      <article class="shell-container">
        <header class="post-hero">
          <span class="eyebrow">{post.category}</span>
          <h1 class="post-heading">{post.title}</h1>
          <div class="post-meta-row">
            <span>{post.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <span>{post.readingTime} min read</span>
          </div>
          {post.tags.length > 0 && (
            <div class="post-tags" style="margin-top: 1rem;">
              {post.tags.map((tag) => <span class="post-tag">{tag}</span>)}
            </div>
          )}
        </header>
        <CopilotVisualWorkflow launcherOnly={true} />
      </article>

      {presentationWorkflowSegments.map((segment) => segment.kind === 'html' ? (
        segment.value.trim() && (
          <article class="shell-container">
            <section class="prose panel">
              <Fragment set:html={segment.value} />
            </section>
          </article>
        )
      ) : (
        <div class="walking-deck-breakout">
          <CopilotVisualWorkflow scene={presentationWorkflowMarkers.indexOf(segment.value)} />
        </div>
      ))}

      <article class="shell-container">
        <nav class="post-pagination">
          {previous ? (
            <a href={previous.permalink}>
              <span>Older</span>
              {previous.title}
            </a>
          ) : <div></div>}

          {next ? (
            <a href={next.permalink} style="text-align: right;">
              <span>Newer</span>
              {next.title}
            </a>
          ) : <div></div>}
        </nav>
      </article>
    </>
  ) : hasWalkingDeck ? (
    <>
      <article class="shell-container">
        <header class="post-hero">
          <span class="eyebrow">{post.category}</span>
          <h1 class="post-heading">{post.title}</h1>
          <div class="post-meta-row">
            <span>{post.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <span>{post.readingTime} min read</span>
          </div>
          {post.tags.length > 0 && (
            <div class="post-tags" style="margin-top: 1rem;">
              {post.tags.map((tag) => <span class="post-tag">{tag}</span>)}
            </div>
          )}
        </header>

        {walkingDeckParts[0]?.trim() && (
          <section class="prose panel">
            <Fragment set:html={walkingDeckParts[0]} />
          </section>
        )}
      </article>

      <div class="walking-deck-breakout">
        <WalkingDeck />
      </div>

      <article class="shell-container">
        {walkingDeckParts.slice(1).join(walkingDeckMarker).trim() && (
          <section class="prose panel">
            <Fragment set:html={walkingDeckParts.slice(1).join(walkingDeckMarker)} />
          </section>
        )}

        <nav class="post-pagination">
          {previous ? (
            <a href={previous.permalink}>
              <span>Older</span>
              {previous.title}
            </a>
          ) : <div></div>}

          {next ? (
            <a href={next.permalink} style="text-align: right;">
              <span>Newer</span>
              {next.title}
            </a>
          ) : <div></div>}
        </nav>
      </article>
    </>
  ) : (
    <article class="shell-container">
      <header class="post-hero">
        <span class="eyebrow">{post.category}</span>
        <h1 class="post-heading">{post.title}</h1>
        <div class="post-meta-row">
          <span>{post.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          <span>{post.readingTime} min read</span>
        </div>
        {post.tags.length > 0 && (
          <div class="post-tags" style="margin-top: 1rem;">
            {post.tags.map((tag) => <span class="post-tag">{tag}</span>)}
          </div>
        )}
      </header>

      <section class="prose panel">
        {hasRuntimeChart ? (
          <>
            <Fragment set:html={runtimeParts[0]} />
            <RuntimeControlChart />
            <Fragment set:html={runtimeParts.slice(1).join(runtimeChartMarker)} />
          </>
        ) : hasCharlotteArtsMap ? (
          <>
            <Fragment set:html={charlotteArtsMapParts[0]} />
            <CharlotteArtsMap />
            <Fragment set:html={charlotteArtsMapParts.slice(1).join(charlotteArtsMapMarker)} />
          </>
        ) : hasThreeNewYears ? (
          <>
            <Fragment set:html={threeNewYearsParts[0]} />
            <ThreeNewYears />
            <Fragment set:html={threeNewYearsParts.slice(1).join(threeNewYearsMarker)} />
          </>
        ) : hasWalkingDeck ? (
          <>
            <Fragment set:html={walkingDeckParts[0]} />
            <WalkingDeck />
            <Fragment set:html={walkingDeckParts.slice(1).join(walkingDeckMarker)} />
          </>
        ) : hasPresentationWorkflowMap ? (
          <>
            <Fragment set:html={presentationWorkflowMapParts[0]} />
            <PresentationWorkflowMap />
            <Fragment set:html={presentationWorkflowMapParts.slice(1).join(presentationWorkflowMapMarker)} />
          </>
        ) : hasAgentHarnessLayers ? (
          <>
            <Fragment set:html={agentHarnessLayersParts[0]} />
            <AgentHarnessLayers />
            <Fragment set:html={agentHarnessLayersParts.slice(1).join(agentHarnessLayersMarker)} />
          </>
        ) : hasCareerSignalMap ? (
          <>
            <Fragment set:html={careerSignalMapParts[0]} />
            <CareerSignalMap />
            <Fragment set:html={careerSignalMapParts.slice(1).join(careerSignalMapMarker)} />
          </>
        ) : hasTokenSilos ? (
          <>
            <Fragment set:html={tokenSilosParts[0]} />
            <TokenSilos />
            <Fragment set:html={tokenSilosParts.slice(1).join(tokenSilosMarker)} />
          </>
        ) : (
          <Fragment set:html={processedHtml} />
        )}
      </section>

      <nav class="post-pagination">
        {previous ? (
          <a href={previous.permalink}>
            <span>Older</span>
            {previous.title}
          </a>
        ) : <div></div>}

        {next ? (
          <a href={next.permalink} style="text-align: right;">
            <span>Newer</span>
            {next.title}
          </a>
        ) : <div></div>}
      </nav>
    </article>
  )}
</Layout>

<style is:global>
  @media (max-width: 620px) {
    body:has(.vw-article-scene) .site-header {
      position: relative;
    }
  }
</style>