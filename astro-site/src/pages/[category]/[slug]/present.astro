---
import '../../../styles/global.css';
import FirstPullRequestDeck from '../../../components/FirstPullRequestDeck.astro';
import CopilotVisualWorkflow from '../../../components/CopilotVisualWorkflow.astro';
import { getPosts, getSiteConfig } from '../../../lib/content';

export function getStaticPaths() {
  return getPosts()
    .filter((post) => ['first-pull-request', 'website-presentation'].includes(post.presentation ?? ''))
    .map((post) => ({
      params: {
        category: post.category,
        slug: post.slug,
      },
      props: { post },
    }));
}

const { post } = Astro.props;
const site = getSiteConfig();
const documentTitle = `${post.title} | Present | ${site.title}`;
const description = `Presentation view for ${post.title}.`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>document.documentElement.classList.add('js', 'presentation-presenting');</script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081a36" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Lora:wght@600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet" />
    <title>{documentTitle}</title>
  </head>
  <body class="presentation-presenting presentation-present-page">
    <noscript>
      <nav class="presentation-fallback-nav" aria-label="Presentation fallback navigation">
        <a href={`/tech/${post.slug}/`}>Return to article</a>
        {post.presentation === 'website-presentation' && (
          <span>
            <a href="#vw-ask">Request</a>
            <a href="#vw-rules">Saved rules</a>
            <a href="#vw-team">Team</a>
            <a href="#vw-proof">Browser checks</a>
            <a href="#vw-gate">Final call</a>
          </span>
        )}
      </nav>
      <style is:global>
        .vw-deck[data-present='true'] {
          position: static !important;
          width: 100% !important;
          height: auto !important;
        }

        .vw-deck[data-present='true'] .vw-hud {
          display: none !important;
        }

        .vw-deck[data-present='true'] .vw-slide {
          position: relative !important;
          inset: auto !important;
          min-height: 100vh !important;
          min-height: 100dvh !important;
          opacity: 1 !important;
          visibility: visible !important;
          pointer-events: auto !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <main id="main-content">
      {post.presentation === 'first-pull-request' && <FirstPullRequestDeck startInPresent={true} />}
      {post.presentation === 'website-presentation' && <CopilotVisualWorkflow startInPresent={true} />}
    </main>

    <script>
      import { initPresentationDeck } from '../../../scripts/presentationDeck.client';
      initPresentationDeck();
      document.addEventListener('astro:page-load', () => initPresentationDeck());
    </script>

    <style is:global>
      html.presentation-presenting,
      body.presentation-present-page {
        margin: 0;
        padding: 0;
        background: #081a36;
        color: white;
        min-height: 100vh;
        min-height: 100dvh;
      }

      body.presentation-present-page #main-content {
        margin: 0;
        padding: 0;
      }

      .presentation-fallback-nav {
        position: sticky;
        top: 0;
        z-index: 10003;
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1rem;
        padding: .75rem 1rem;
        background: #06171f;
        color: white;
      }

      .presentation-fallback-nav span {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem 1rem;
      }

      .presentation-fallback-nav a {
        color: #34baff;
      }

    </style>
  </body>
</html>