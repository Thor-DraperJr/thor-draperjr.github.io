---
import Layout from '../layouts/Layout.astro';
import { getPosts } from '../lib/content';

const posts = getPosts();
const professionalCategories = new Set(['tech', 'career', 'business']);
const heroPost = posts.find((post) => post.categories.some((category) => professionalCategories.has(category)));
const recentPosts = posts.filter((post) => post !== heroPost).slice(0, 6);
---

<Layout pageTitle="Home" currentPath="/" wide>
	<section class="home-stage" aria-labelledby="home-title">
		<div class="home-stage-energy" aria-hidden="true"></div>
		<div class="shell-container shell-container-wide">
		<div class="home-grid home-signal-grid">
			<div>
				<span class="eyebrow" data-reveal>Operator's notebook</span>
				<h1 id="home-title" class="home-headline" data-reveal data-reveal-delay="1">What holds up after the meeting.</h1>
				<p class="home-copy" data-reveal data-reveal-delay="2">
					I use this site to think in public, make sense of what I am learning, and keep a record of the ideas I want to come back to.
					It is a working library built from the work itself: security, cloud, AI, leadership, and the long game of execution.
				</p>

				<div class="button-row" data-reveal data-reveal-delay="3">
					<a class="button" href="/archive/">Browse the archive</a>
					{heroPost && <a class="button-ghost" href={heroPost.permalink}>Read the featured article</a>}
				</div>
			</div>

			<div class="home-rail">
				{heroPost && (
					<article class="feature-panel home-latest-card" data-reveal data-reveal-delay="4">
						<span class="eyebrow">Latest professional article</span>
						<h2 class="feature-panel-title"><a href={heroPost.permalink}>{heroPost.title}</a></h2>
						<p class="card-copy">{heroPost.excerpt}</p>
						<div class="meta-row">
							<span>{heroPost.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</span>
							<span>{heroPost.readingTime} min read</span>
						</div>
					</article>
				)}
			</div>
		</div>
		</div>
		<div class="home-stage-threshold" aria-hidden="true"></div>
	</section>

	<section class="home-body" aria-label="Homepage body">
		<div class="home-body-field" aria-hidden="true"></div>
		<section class="shell-container shell-container-wide section-block home-writing-section" data-reveal>
			<div class="section-header">
				<div>
					<span class="eyebrow">Recent writing</span>
					<h2 class="section-title">Latest from the notebook.</h2>
				</div>
				<p class="section-copy">Professional work and personal notes, together in straightforward chronological order.</p>
			</div>

			<div class="home-post-grid">
				{recentPosts.map((post, index) => (
					<article class="home-post-card" data-reveal data-reveal-delay={String(Math.min(index + 1, 4))}>
						<div class="card-topline">
							<span class="eyebrow">{post.categories[0]}</span>
							<span class="stream-date">{post.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</span>
						</div>
						<h3 class="stream-title"><a href={post.permalink}>{post.title}</a></h3>
						<p class="stream-excerpt">{post.excerpt}</p>
						<div class="stream-meta">{post.readingTime} min read</div>
					</article>
				))}
			</div>

			<div class="button-row" style="margin-top: 1.5rem;">
				<a class="button-ghost" href="/archive/">View the full archive</a>
			</div>
		</section>

		<section class="home-about-band" data-reveal>
			<div class="shell-container shell-container-wide home-about-inner">
			<div class="section-header">
				<div>
					<span class="eyebrow">About Thor</span>
					<h2 class="section-title">What keeps showing up in the work.</h2>
				</div>
				<p class="section-copy">Trust, translation, and a longer view than the room usually wants to take.</p>
			</div>

			<article class="home-about-panel" data-reveal data-reveal-delay="1">
				<p class="section-copy">The roles changed over time, but the pattern did not. I keep getting pulled toward work that rewards clarity, trust, and the ability to make complicated things usable for someone else.</p>
				<div class="note-grid" style="margin-top: 1.25rem;">
					<div class="home-about-note">
						<h3>Technology without theater</h3>
						<p class="section-copy">Architecture, platforms, and new tools explained in ways people can actually use.</p>
					</div>
					<div class="home-about-note">
						<h3>Career advice without fluff</h3>
						<p class="section-copy">Momentum, feedback, habits, and positioning without pretending a title solves the problem.</p>
					</div>
					<div class="home-about-note">
						<h3>Experiments worth keeping</h3>
						<p class="section-copy">Drafts, operating principles, and technology experiments captured before they disappear into a notes app.</p>
					</div>
				</div>
				<div class="button-row" style="margin-top: 1rem;">
					<a class="button-ghost" href="/about/">Read the full story</a>
					<a class="button-ghost" href="/resume/">View the resume</a>
				</div>
			</article>
			</div>
		</section>
	</section>
</Layout>
